# Frontend-only prototype. NEVER put secrets in VITE_* variables — they are bundled into the browser.
# Optional: override the IBTrACS CSV URLs (e.g. to a same-origin mirror of the unmodified official files).
VITE_IBTRACS_NI_URL=
VITE_IBTRACS_ACTIVE_URL=

# Backend-only credentials (NOT used by this frontend prototype; reserved for the future ingestion service).
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
